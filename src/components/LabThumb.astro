---
// Simple generated thumbnails for lab cards that don't have a screenshot yet.
interface Props {
  kind: "rings" | "table" | "line" | "bars";
}
const { kind } = Astro.props;
const rows = [0, 1, 2, 3, 4];
const heights = [18, 24, 30, 44, 52, 70, 88, 104, 120];
---

<svg viewBox="0 0 320 200" aria-hidden="true">
  {
    kind === "rings" && (
      <>
        <circle cx="160" cy="100" r="64" fill="none" stroke="var(--pink)" stroke-width="14" stroke-dasharray="402" stroke-dashoffset="80" stroke-linecap="round" transform="rotate(-90 160 100)" />
        <circle cx="160" cy="100" r="44" fill="none" stroke="var(--blue)" stroke-width="14" stroke-dasharray="276" stroke-dashoffset="110" stroke-linecap="round" transform="rotate(-90 160 100)" />
      </>
    )
  }
  {
    kind === "table" &&
      rows.map((i) => (
        <>
          <rect x="40" y={36 + i * 26} width="240" height="18" fill={i % 2 ? "var(--hi)" : "var(--card)"} stroke="var(--ink)" stroke-width="1" />
          <rect x="48" y={42 + i * 26} width={60 + ((i * 13) % 50)} height="6" fill="var(--blue)" />
        </>
      ))
  }
  {
    kind === "line" && (
      <>
        <polyline points="20,140 45,90 70,120 95,60 120,110 145,70 170,130 195,50 220,100 245,80 270,120 300,65" fill="none" stroke="var(--blue)" stroke-width="3" />
        <line x1="20" y1="95" x2="300" y2="95" stroke="var(--pink)" stroke-width="3" stroke-dasharray="8 6" />
      </>
    )
  }
  {
    kind === "bars" &&
      heights.map((h, i) => (
        <rect x={40 + i * 28} y={170 - h} width="20" height={h} fill={i % 3 ? "var(--blue)" : "var(--pink)"} />
      ))
  }
</svg>
