---
import type { CollectionEntry } from "astro:content";
import { formatDate, postUrl } from "../lib/utils";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const first = Math.min(...posts.map((p) => p.data.pubDate.getUTCFullYear()), 2014);
const last = new Date().getUTCFullYear();
const years = Array.from({ length: last - first + 1 }, (_, i) => last - i);
const months = ["J", "F", "M", "A", "M", "J", "J", "A", "S", "O", "N", "D"];
const byMonth = new Map<string, CollectionEntry<"posts">[]>();
for (const p of posts) {
  const key = `${p.data.pubDate.getUTCFullYear()}-${p.data.pubDate.getUTCMonth()}`;
  byMonth.set(key, [...(byMonth.get(key) ?? []), p]);
}
const level = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n < 4 ? 2 : 3);
---

<figure class="heatmap">
  <div class="heatmap-grid" role="table" aria-label="Posts per month by year">
    <div role="row" class="heatmap-row head">
      <span role="columnheader"></span>
      {months.map((m) => <span role="columnheader">{m}</span>)}
    </div>
    {
      years.map((y) => (
        <div role="row" class="heatmap-row">
          <span role="rowheader">{y}</span>
          {months.map((_, m) => {
            const items = byMonth.get(`${y}-${m}`) ?? [];
            const label = items.length
              ? items.map((p) => `${p.data.title} (${formatDate(p.data.pubDate, "short")})`).join("; ")
              : "nothing";
            return items.length ? (
              <a role="cell" href={postUrl(items[0].id)} class={`cell l${level(items.length)}`} title={label} aria-label={label} />
            ) : (
              <span role="cell" class="cell l0" title={label} />
            );
          })}
        </div>
      ))
    }
  </div>
  <figcaption>
    <slot />
  </figcaption>
</figure>
