---
// A tiny pedometer: converts scroll distance into "steps" (~ one step per 80px).
// Purely local; nothing is stored or sent anywhere.
---

<div class="steps" aria-live="off" title="Steps taken on this page (one step ≈ 80px of scrolling)">
  <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="8" cy="7.5" rx="3" ry="4.5"/><circle cx="7.6" cy="15" r="1.9"/><ellipse cx="16" cy="11.5" rx="3" ry="4.5"/><circle cx="16.4" cy="19" r="1.9"/></svg>
  <span class="steps-count">0</span>
  <span class="steps-label">steps</span>
</div>

<script>
  const el = document.querySelector<HTMLElement>(".steps-count");
  const wrap = el?.parentElement;
  let traveled = 0;
  let last = window.scrollY;
  let goalHit = false;
  window.addEventListener(
    "scroll",
    () => {
      traveled += Math.abs(window.scrollY - last);
      last = window.scrollY;
      const steps = Math.floor(traveled / 80);
      if (el) el.textContent = steps.toLocaleString();
      wrap?.classList.toggle("moving", steps > 0);
      if (!goalHit && steps >= 100) {
        goalHit = true;
        wrap?.classList.add("goal");
        if (wrap) wrap.title = "100 steps! Your daily goal for reading my website has been met.";
      }
    },
    { passive: true },
  );
</script>
