---
import vitals from "../data/vitals.json";
---

<section class="vitals" aria-label="Current readouts">
  <p class="vitals-status"><span class="dot" aria-hidden="true"></span>{vitals.status}</p>
  <dl>
    {
      vitals.readouts.map((r) => (
        <div>
          <dt>{r.label}</dt>
          <dd>{r.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
