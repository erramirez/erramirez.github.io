---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ActivityRings from "../components/ActivityRings.astro";
import Vitals from "../components/Vitals.astro";
import WritingHeatmap from "../components/WritingHeatmap.astro";
import { formatDate, getPosts, postUrl } from "../lib/utils";

const posts = await getPosts();
const latest = posts.slice(0, 4);
const featuredResearch = (await getCollection("research"))
  .filter((item) => !item.data.draft && item.data.featured)
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <h1>Hi, I'm <em>Ernesto</em>.</h1>
      <p class="lede">
        I work where digital health, patient-generated data, and decentralized research meet. I
        try to do research that matters, because data are made of people.
      </p>
      <div class="actions">
        <a class="button primary" href="/research/">Selected research</a>
        <a class="button" href="/posts/">Read the writing</a>
      </div>
    </div>
    <ActivityRings />
  </section>

  <Vitals />

  <section class="band">
    <h2>What I think about</h2>
    <ul class="questions">
      <li>
        <a href="/about/#digital-health">
          <h3>Digital health</h3>
          <p>How can sensors, devices, and patient-generated data produce evidence people can use?</p>
        </a>
      </li>
      <li>
        <a href="/about/#research-methods">
          <h3>Research methods</h3>
          <p>How do you turn ambiguous objectives into rigorous evidence?</p>
        </a>
      </li>
      <li>
        <a href="/about/#data-communication">
          <h3>Data communication</h3>
          <p>How do you tell the story of the data you've collected?</p>
        </a>
      </li>
    </ul>
  </section>

  <section class="band">
    <div class="section-heading">
      <h2>Selected research</h2>
      <a href="/research/">View all</a>
    </div>
    <div class="research-list">
      {
        featuredResearch.map((item) => (
          <article class="research-item">
            <p class="meta">{item.data.role} · {item.data.timeframe}</p>
            <h3><a href={`/research/${item.id}/`}>{item.data.title}</a></h3>
            <p>{item.data.description}</p>
            <ul class="tag-list">
              {item.data.areas.map((area) => <li>{area}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="band split">
    <div>
      <div class="section-heading">
        <h2>Latest writing</h2>
        <a href="/posts/">View all</a>
      </div>
      <div class="post-list">
        {
          latest.map((post) => (
            <article>
              <p class="meta">
                {formatDate(post.data.pubDate)}
                {post.data.kind === "note" && <span class="badge">note</span>}
              </p>
              <h3><a href={postUrl(post.id)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </article>
          ))
        }
      </div>
    </div>
    <WritingHeatmap posts={posts}>
      <b>My writing streak, honestly reported.</b> Each square is a month. The long quiet stretch
      after 2017 is technically known as "having kids."
    </WritingHeatmap>
  </section>
</BaseLayout>
