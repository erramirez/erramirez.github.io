---
import BaseLayout from "../layouts/BaseLayout.astro";
import SqlConsole from "../components/SqlConsole.astro";
import home from "../data/home.json";
import { formatDate, getLab, getPosts, labUrl, postUrl } from "../lib/utils";

const posts = (await getPosts()).filter((p) => !p.data.draft).slice(0, 4);
const lab = (await getLab()).slice(0, 4);
const [before, after] = home.intro.includes(home.highlight)
  ? home.intro.split(home.highlight)
  : [home.intro, undefined];
---

<BaseLayout>
  <div class="hero">
    <div>
      <h1 class="h-xl">
        <span class="p">Ernesto<br />Ramirez</span><span class="b" aria-hidden="true">Ernesto<br />Ramirez</span>
      </h1>
      <p class="sub">{home.tagline}</p>
      <p class="lede">
        {before}{after !== undefined && <><mark>{home.highlight}</mark>{after}</>}
      </p>
      <p class="hand" style="margin-top:18px">↓ {home.handNote}</p>
    </div>
    <figure class="specimen">
      <div class="duo"><img src={home.photo} alt="Ernesto Ramirez" width="520" height="734" /></div>
      <div class="tag">
        {home.photoLabel.map((line, i) => (i === 0 ? <i>{line}</i> : <><br />{line}</>))}
      </div>
    </figure>
  </div>

  <SqlConsole />

  <div class="two">
    <div>
      <h2 class="h-m">Latest writing</h2>
      <p class="cap">Essays, notes, and R experiments.</p>
      <ul class="log">
        {
          posts.map((p) => (
            <li>
              <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
              <a href={postUrl(p.id)} title={formatDate(p.data.pubDate)}>{p.data.title}</a>
            </li>
          ))
        }
      </ul>
      <a class="more" href="/posts/">All writing →</a>
    </div>
    <div>
      <h2 class="h-m">From the lab</h2>
      <p class="cap">Small apps and data toys.</p>
      <ul class="log">
        {
          lab.map((l) => {
            const href = labUrl(l) ?? "/lab/";
            return (
              <li>
                <time><span class={`status ${l.data.status}`}>{l.data.status}</span></time>
                <a href={href}>{l.data.title}</a>
              </li>
            );
          })
        }
      </ul>
      <a class="more" href="/lab/">Visit the lab →</a>
    </div>
  </div>
</BaseLayout>
