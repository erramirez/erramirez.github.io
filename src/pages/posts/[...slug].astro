---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, tagUrl } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 230));
---

<BaseLayout title={`${post.data.title} | Ernesto Ramirez`} description={post.data.description}>
  <p class="meta-line" style="margin-top:32px"><a href="/posts/">← Writing</a></p>
  <h1 class="h-l" style="margin-top:16px">{post.data.title}</h1>
  <p class="meta-line">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> · {minutes} min read
    {
      post.data.tags.length > 0 && (
        <>
          {" · "}
          {post.data.tags.map((t, i) => (
            <>
              {i > 0 && ", "}
              <a class="tags" href={tagUrl(t)}>{t}</a>
            </>
          ))}
        </>
      )
    }
  </p>
  {
    post.data.archive && (
      <p class="archive">
        From the archive: written in {post.data.pubDate.getUTCFullYear()} on the old site. Some links and tools may have aged.
      </p>
    )
  }
  <article class="prose" style="margin-top:32px">
    <Content />
  </article>
  <nav class="post-nav" aria-label="More posts">
    {newer ? <a href={`/posts/${newer.id}/`}>← {newer.data.title}</a> : <span />}
    {older && <a href={`/posts/${older.id}/`}>{older.data.title} →</a>}
  </nav>
</BaseLayout>
