---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, postUrl, slugify } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tagged ${tag} | Ernesto Ramirez`}>
  <p class="meta-line" style="margin-top:32px"><a href="/posts/">← Writing</a></p>
  <h1 class="h-l" style="margin-top:16px">{tag}</h1>
  <ul class="log">
    {
      posts.map((p) => (
        <li>
          <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate, "short")}</time>
          <div>
            <a href={postUrl(p.id)}>{p.data.title}</a>
            {p.data.description && <p>{p.data.description}</p>}
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
