---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const research = await getCollection("research", ({ data }) => !data.draft);
  return research.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={`${item.data.title} | Ernesto Ramirez`} description={item.data.description}>
  <p class="meta-line" style="margin-top:32px"><a href="/research/">← Research</a></p>
  <h1 class="h-l" style="margin-top:16px">{item.data.title}</h1>
  <p class="meta-line">{item.data.role} · {item.data.timeframe} · <span class="tags">{item.data.areas.join(", ")}</span></p>
  <article class="prose" style="margin-top:32px">
    <Content />
  </article>
</BaseLayout>
