---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const research = (await getCollection("research"))
  .filter((item) => !item.data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout title="Research | Ernesto Ramirez" description="Selected research and case studies by Ernesto Ramirez.">
  <h1 class="h-l">Research</h1>
  <p class="lede" style="margin-top:6px">Selected work on digital health evidence, patient-generated data, and research communication.</p>
  <ul class="log" style="margin-top:30px;max-width:46rem">
    {
      research.map((item) => (
        <li>
          <time>{item.data.timeframe}</time>
          <div>
            <a href={`/research/${item.id}/`}>{item.data.title}</a>
            <p>{item.data.description}</p>
            <div class="tags">{item.data.areas.join(", ")}</div>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
